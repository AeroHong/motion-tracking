rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 운동 추적 보고서 PNG: 본인만 읽기/쓰기
    match /reports/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
    // 이중슬릿 실험 이미지: 본인만 읽기/쓰기
    match /slit/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
    // 회절 실험 이미지: 본인만 읽기/쓰기
    match /diff/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
